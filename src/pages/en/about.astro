---
import BaseLayout from '../../layouts/BaseLayout.astro';

const skills = [
  { category: "Languages", items: ["Python", "Scala", "Java", "SQL", "Shell Script"] },
  { category: "Distributed Data & Streaming", items: ["Apache Kafka", "Apache Spark", "Dataflow", "Hive", "MapReduce"] },
  { category: "Orchestration", items: ["Apache Airflow", "AWS Glue Workflows"] },
  { category: "AWS", items: ["Glue", "S3", "Lambda", "DynamoDB", "RDS", "SageMaker", "CloudWatch", "CodeBuild", "CloudFormation"] },
  { category: "GCP", items: ["BigQuery", "Dataproc", "Dataflow", "Bigtable", "GKE/Kubernetes", "Cloud Storage", "Cloud Build"] },
  { category: "MLOps", items: ["Model and LLM Productionization", "CI/CD", "Observability and Alerting", "Model Serving", "Prediction APIs"] },
  { category: "Applied AI", items: ["Claude and Code Agents", "Gemma", "Llama", "Qwen"] },
];

const companies = [
  { name: "Equifax / Boa Vista Serviços", domain: "Credit Scoring" },
  { name: "TIM", domain: "Telecom" },
  { name: "Vivo", domain: "Telecom" },
  { name: "GPA", domain: "Food Retail" },
  { name: "Prudential", domain: "Life Insurance" },
];

const experience = [
  {
    title: "Tech Lead - Data Engineering & MLOps",
    company: "Digiage Technologies, assigned to a large multinational insurance company (life insurance and investment products)",
    location: "Campinas, SP",
    period: "06/2024 - Present",
    bullets: [
      "Lead a squad of 5 to 8 data engineers: technical and strategic team management, solution architecture, and project management over a ~900 TB data lake (AWS, medallion architecture, Glue Workflows, Jobs, and Data Catalog).",
      "Led the integration of a new policy sales and claims management system (life insurance with investment product): business rules review, data modeling and mapping, and ETL development into the lake standard.",
      "Maintained and evolved a CDC pipeline with Apache Kafka for customer, policy, and complaint data, processed and served through DynamoDB with APIs consumed by the customer service CRM.",
      "Built ETL observability from scratch: a Python library for Glue jobs with Lambda-triggered alerts in Microsoft Teams (error details and CloudWatch log link), moving the team from incident-driven detection to proactive resolution before users noticed issues.",
      "Led the data engineering and MLOps work of the company's first AI project, a decision-support solution for claims analysis: aggregating customer, policy, and complaint data, integrating with the classification model developed by the data science team, and delivering grounded recommendations in a Power BI dashboard.",
      "Managed the Open Insurance integration: receiving data from other insurers and submitting data in the regulatory standard required by SUSEP.",
    ],
  },
  {
    title: "MLOps Engineer (part-time)",
    company: "Inovia",
    location: "Remote",
    period: "05/2025 - Present",
    bullets: [
      "Built the production pipeline for 3 open-source LLMs (Gemma, Llama, and Qwen) to productionize a document analysis solution.",
      "Developed prediction serving and management APIs, with model and version orchestration.",
      "Manage the cloud infrastructure serving models to external customers.",
      "Integrate generative AI into the engineering workflow (Claude and agents): code review, code quality and security, code standardization, and logging. Implemented unit and end-to-end tests with Claude assistance.",
    ],
  },
  {
    title: "Data Engineer",
    company: "Lima Consulting",
    location: "Campinas, SP",
    period: "04/2023 - 06/2024",
    bullets: [
      "Implemented and maintained CDPs (Adobe Experience Platform / Real-Time CDP) for large telecom, retail, and banking companies; the main project served a telecom carrier with roughly 80 million customers.",
      "Modeled XDM schemas with schema evolution and built batch data ingestion (BigQuery connection and CSV file mapping) and streaming ingestion, configuring client-side Kafka integrated with AEP.",
      "Used AEP APIs to query customer, campaign, and segment data.",
      "Developed analytical reports through Query Service (PostgreSQL with nested JSON structures): parsing data to track each customer's campaign touchpoints, reproducing Adobe's native graphical view with more precise filters.",
      "Created multichannel activation journeys in Adobe Journey Optimizer (email, push, and SMS), including domain IP warming strategies, and contributed to the native Zenvia-Adobe integration for SMS delivery, specifying endpoints and documenting the data exchange between systems.",
      "Built data pipelines with Airflow and Redshift across AWS and GCP environments.",
    ],
  },
  {
    title: "Data Engineer - MLOps",
    company: "Boa Vista SCPC, now Equifax Brazil",
    location: "Campinas, SP",
    period: "03/2021 - 04/2023",
    bullets: [
      "Created an internal Feature Store for registering and managing models and variables (SQL and metadata, with edit and delete), with OAuth 2.0 authentication integrated with GCP and a Bootstrap frontend.",
      "Refactored similarity and segmentation variable calculations from BigQuery to Spark/Scala on Dataproc (10 to 15 node cluster): runtime reduced from days, with failures and restarts, to about 4 hours, cutting cloud costs.",
      "Developed REST APIs in Flask and Airflow DAGs with Python jobs for data processing and model and variable calculation.",
      "Deployed through CI/CD and maintained projects on GCP: Kubernetes, Dataflow, Bigtable, BigQuery, and Cloud Storage.",
    ],
  },
  {
    title: "Data Engineer",
    company: "Digiage Technologies",
    location: "Campinas, SP",
    period: "06/2019 - 03/2021",
    bullets: [
      "Developed Java MapReduce routines, running on on-premise servers, to generate prepaid and postpaid customer indicators for the marketing team of a major telecom carrier, processing ETLs of roughly 4.5 billion rows, with per-environment algorithm tuning.",
      "Supported business rule definitions, mapping the paths between tables to reach the information requested by the marketing team.",
      "Performed loads and optimizations on Hive and Greenplum through Apache Sqoop, produced analyses and reports, and maintained SAS scripts.",
    ],
  },
];
---

<BaseLayout title="About" description="About Thales Pomari – Tech Lead Data Engineer and MLOps specialist.">

  <section class="section">
    <div class="container">
      <p class="section-label">// About</p>
      <h1>Thales Pomari</h1>
      <p class="subtitle">Tech Lead · Data Engineer · MLOps</p>
    </div>
  </section>

  <hr class="divider" style="margin:0; border-color: var(--border);" />

  <!-- BIO -->
  <section class="section">
    <div class="container bio-grid">
      <div class="bio-label">
        <p class="section-label">// Bio</p>
      </div>
      <div class="bio-content">
        <p>
          I started my career as a researcher, publishing a
          <a href="https://ieeexplore.ieee.org/document/8451227" target="_blank" rel="noopener">paper at IEEE ICIP (International Conference on Image Processing)</a>
          before finding my path in data. I later grounded that foundation with a
          <strong>Postgraduate Program in Data Science</strong>.
        </p>
        <p>
          Today I'm a Data Engineer and MLOps specialist, building data infrastructure
          and AI systems that solve real business problems at scale. My work spans
          credit scoring, telecom, food retail, and life insurance, which gives me a broad
          perspective on how data challenges vary by domain and budget.
        </p>
        <p>
          My current stack centers on <strong>Apache Spark + Delta Lake</strong> for large-scale
          data processing, <strong>AWS</strong> as my main cloud platform, and
          <strong>FastAPI + HuggingFace</strong> for AI-powered services.
        </p>
        <p>
          My signature skill is <strong>learning fast and finding the right technology fit</strong>
          for the time and budget of each problem. I don't over-engineer. I build what's needed,
          when it's needed, at the right cost. As a tech leader, I also invest in the people side:
          communicating clearly across teams, unblocking colleagues, and making sure technical
          decisions are understood by everyone involved, not just engineers.
        </p>
      </div>
    </div>
  </section>

  <hr class="divider" style="margin:0; border-color: var(--border);" />

  <!-- SKILLS -->
  <section class="section">
    <div class="container">
      <div class="bio-grid">
        <div class="bio-label">
          <p class="section-label">// Stack</p>
        </div>
        <div class="skills-grid">
          {skills.map(group => (
            <div class="skill-group">
              <h3>{group.category}</h3>
              <ul class="skill-list">
                {group.items.map(item => (
                  <li><span class="tag">{item}</span></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" style="margin:0; border-color: var(--border);" />

  <!-- COMPANIES -->
  <section class="section">
    <div class="container">
      <div class="bio-grid">
        <div class="bio-label">
          <p class="section-label">// Experience</p>
        </div>
        <div>
          <p style="color:var(--muted); margin-bottom: 2rem;">Companies and domains I've delivered data and AI solutions for:</p>
          <div class="companies-list">
            {companies.map((c, i) => (
              <div class="company-item">
                <span class="company-index">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <strong>{c.name}</strong>
                  <span class="company-domain">{c.domain}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" style="margin:0; border-color: var(--border);" />

  <!-- CTA -->
  <section class="section">
    <div class="container" style="text-align:center;">
      <h2>Let's build something.</h2>
      <p style="color:var(--muted);margin: 1rem auto 2rem;">Available for data engineering and AI infrastructure projects.</p>
      <a href="mailto:hello@thalespomari.dev" class="btn btn-accent">Get in Touch →</a>
      <p style="color:var(--muted);font-family:var(--font-mono);font-size:0.8rem;margin-top:1.5rem;">São Paulo, BR</p>
    </div>
  </section>

</BaseLayout>

<style>
  .bio-content a {
    color: var(--accent);
    text-decoration: underline;
    font-weight: 500;
  }

  .bio-content a:hover {
    color: var(--accent);
  }

  .subtitle {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--muted);
    margin-top: 0.5rem;
    letter-spacing: 0.05em;
  }

  .bio-grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .bio-content p + p {
    margin-top: 1.25rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .skill-group h3 {
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.05em;
  }

  .skill-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .companies-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 2px solid var(--border);
    box-shadow: var(--shadow);
  }

  .company-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 1.25rem;
    border-bottom: 2px solid var(--border);
    transition: background 0.1s;
  }

  .company-item:last-child {
    border-bottom: none;
  }

  .company-item:hover {
    background: var(--fg);
    color: var(--bg);
  }

  .company-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    min-width: 2rem;
  }

  .company-item:hover .company-index {
    color: var(--accent);
  }

  .company-domain {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
    font-family: var(--font-mono);
    margin-top: 0.1rem;
  }

  .company-item:hover .company-domain {
    color: var(--bg);
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .bio-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
