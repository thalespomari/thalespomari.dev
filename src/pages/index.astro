---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Início" description="Thales Pomari — MLOps Engineer & Data Engineer. Pipelines de dados e infraestrutura de IA em escala, da ingestão bruta a modelos de ML e LLMs em produção.">

  <!-- HERO -->
  <section class="section hero-section">
    <div class="container">
      <p class="section-label">// MLOps & Data Engineering</p>
      <h1>
        Eu construo<br/>
        <span class="highlight">pipelines de dados</span><br/>
        & infra de IA<br/>
        em escala.
      </h1>
      <p class="hero-sub">
        Spark, Kafka, AWS, GCP e LLMs em produção.<br/>
        Da ingestão bruta a modelos servindo clientes reais.
      </p>
      <div class="hero-cta">
        <a href="/projects" class="btn btn-accent">Ver Projetos</a>
        <a href="#contact" class="btn">Entrar em Contato</a>
      </div>
    </div>
  </section>

  <!-- STACK MARQUEE -->
  <div class="marquee-wrapper">
    <div class="marquee-track">
      <span>Apache Spark</span>
      <span>·</span>
      <span>Apache Kafka</span>
      <span>·</span>
      <span>AWS</span>
      <span>·</span>
      <span>GCP</span>
      <span>·</span>
      <span>Apache Airflow</span>
      <span>·</span>
      <span>Glue</span>
      <span>·</span>
      <span>BigQuery</span>
      <span>·</span>
      <span>Python</span>
      <span>·</span>
      <span>Scala</span>
      <span>·</span>
      <span>Docker</span>
      <span>·</span>
      <span>MLOps</span>
      <span>·</span>
      <span>LLMs</span>
      <span>·</span>
      <span>DynamoDB</span>
      <span>·</span>
      <span>SageMaker</span>
      <span>·</span>
      <span>CI/CD</span>
      <span>·</span>
      <span>Apache Spark</span>
      <span>·</span>
      <span>Apache Kafka</span>
      <span>·</span>
      <span>AWS</span>
      <span>·</span>
      <span>GCP</span>
      <span>·</span>
      <span>Apache Airflow</span>
      <span>·</span>
      <span>Glue</span>
      <span>·</span>
      <span>BigQuery</span>
      <span>·</span>
      <span>Python</span>
      <span>·</span>
      <span>Scala</span>
      <span>·</span>
      <span>Docker</span>
      <span>·</span>
      <span>MLOps</span>
      <span>·</span>
      <span>LLMs</span>
      <span>·</span>
      <span>DynamoDB</span>
      <span>·</span>
      <span>SageMaker</span>
      <span>·</span>
      <span>CI/CD</span>
      <span>·</span>
    </div>
  </div>

  <!-- NUMBERS -->
  <section class="section numbers-section">
    <div class="container numbers-grid">
      <div class="number-item">
        <p class="number-value">7+</p>
        <p class="number-label">anos de experiência</p>
      </div>
      <div class="number-item">
        <p class="number-value">~900 TB</p>
        <p class="number-label">de data lake</p>
      </div>
      <div class="number-item">
        <p class="number-value">80M</p>
        <p class="number-label">clientes impactados</p>
      </div>
      <div class="number-item">
        <p class="number-value">4,5B</p>
        <p class="number-label">linhas processadas</p>
      </div>
    </div>
  </section>

  <!-- ABOUT TEASER -->
  <section class="section">
    <div class="container about-teaser">
      <div>
        <p class="section-label">// Quem sou eu</p>
        <h2>Tech Lead<br/>Data Engineer</h2>
      </div>
      <div class="about-teaser-body">
        <p>
          Tech Lead e Data Engineer com 7 anos de experiência em Data Engineering e MLOps,
          construindo pipelines de dados e infraestrutura de IA em escala. Lidero squads técnicos
          e já entreguei soluções para <strong>Equifax / Boa Vista Serviços</strong>, <strong>TIM</strong>,
          <strong>Vivo</strong>, <strong>GPA</strong> e <strong>Prudential</strong>, atuando em credit
          scoring, telecom, varejo e seguros.
        </p>
        <p>
          Domino Apache Spark, Delta Lake, AWS, GCP e FastAPI/HuggingFace para sistemas de IA em
          produção. Iniciei a carreira como pesquisador, com um artigo publicado no IEEE ICIP —
          base que moldou minha abordagem rigorosa e orientada a dados para resolver problemas de
          negócio complexos.
        </p>
        <a href="/about" class="btn" style="margin-top:1.5rem;">Mais Sobre Mim →</a>
      </div>
    </div>
  </section>

  <!-- FEATURED PROJECT -->
  <section class="section" style="background: var(--fg); color: var(--bg);">
    <div class="container">
      <p class="section-label" style="color: var(--accent);">// Projeto em Destaque</p>
      <div class="featured-project">
        <div>
          <h2 style="color: var(--bg);">AI<br/>Orchestrator</h2>
          <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin:1rem 0;">
            <span class="tag" style="background:var(--bg);color:var(--fg);">FastAPI</span>
            <span class="tag" style="background:var(--bg);color:var(--fg);">Redis</span>
            <span class="tag" style="background:var(--bg);color:var(--fg);">RAG</span>
            <span class="tag" style="background:var(--bg);color:var(--fg);">Docker</span>
            <span class="tag" style="background:var(--bg);color:var(--fg);">EC2</span>
          </div>
        </div>
        <div>
          <p style="color: var(--bg); opacity: 0.85; margin-bottom: 1.5rem;">
            Um orquestrador de processamento de jobs distribuído que gerencia workers de forma
            assíncrona via API REST. Os workers executam um pipeline RAG sobre documentos PDF,
            armazenando estado no Redis e reportando resultados de volta ao orquestrador.
            Containerizado com Docker e controlado por systemd na AWS EC2.
          </p>
          <a href="/projects" class="btn btn-invert">
            Ver Todos os Projetos →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section" id="contact">
    <div class="container contact-section">
      <div>
        <p class="section-label">// Contato</p>
        <h2>Vamos trabalhar<br/>juntos.</h2>
        <p style="margin-top:1rem;color:var(--muted);">
          Tem um projeto que precisa de infraestrutura de dados ou pipelines de IA?
          Estou disponível para trabalhos freelance e consultoria.
        </p>
      </div>
      <div class="contact-links">
        <a href="mailto:hello@thalespomari.dev" class="btn btn-accent">
          → hello@thalespomari.dev
        </a>
        <a href="https://linkedin.com/in/thalespomari" target="_blank" rel="noopener" class="btn">
          → LinkedIn
        </a>
        <a href="https://github.com/thalespomari" target="_blank" rel="noopener" class="btn">
          → GitHub
        </a>
        <p style="margin-top:0.5rem;color:var(--muted);font-family:var(--font-mono);font-size:0.8rem;">
          Campinas, SP, Brazil
        </p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero */
  .hero-section {
    padding-top: 6rem;
    padding-bottom: 5rem;
  }

  .hero-section h1 {
    margin: 1rem 0 1.5rem;
  }

  .hero-sub {
    font-size: 1.1rem;
    color: var(--muted);
    margin-bottom: 2rem;
    max-width: 50ch;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Marquee */
  .marquee-wrapper {
    overflow: hidden;
    border-top: 2px solid var(--border);
    border-bottom: 2px solid var(--border);
    padding: 0.75rem 0;
    background: var(--accent);
    color: #fff;
  }

  .marquee-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    animation: marquee 30s linear infinite;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Numbers */
  .numbers-section {
    border-bottom: 2px solid var(--border);
    padding: 3.5rem 0;
  }

  .numbers-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .number-item {
    text-align: center;
  }

  .number-value {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    color: var(--accent);
    line-height: 1.1;
  }

  .number-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.5rem;
  }

  /* About teaser */
  .about-teaser {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .about-teaser-body p + p {
    margin-top: 1rem;
  }

  /* Featured project */
  .featured-project {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 4rem;
    align-items: start;
    margin-top: 1.5rem;
  }

  /* Contact */
  .contact-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 2.5rem;
  }

  @media (max-width: 768px) {
    .about-teaser,
    .featured-project,
    .contact-section {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .numbers-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1rem;
    }
  }
</style>
