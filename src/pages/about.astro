---
import BaseLayout from '../layouts/BaseLayout.astro';

const skills = [
  { category: "Data", items: ["Apache Spark", "Delta Lake", "PySpark", "SQL", "dbt", "Airflow"] },
  { category: "AI / ML", items: ["HuggingFace", "RAG", "LLMs", "FastAPI", "MLflow", "Python"] },
  { category: "Cloud & Infra", items: ["AWS (EC2, S3, Lambda)", "Docker", "systemd", "Redis", "Git"] },
  { category: "Practices", items: ["MLOps", "DataOps", "REST APIs", "Async Processing", "Distributed Systems"] },
];

const companies = [
  { name: "Equifax / Boa Vista Serviços", domain: "Credit Scoring" },
  { name: "TIM (via Dell)", domain: "Telecom" },
  { name: "Vivo", domain: "Telecom" },
  { name: "GPA", domain: "Food Retail" },
  { name: "Prudential", domain: "Life Insurance" },
];
---

<BaseLayout title="About" description="About Thales Pomari – Tech Lead Data Engineer and MLOps specialist.">

  <section class="section">
    <div class="container">
      <p class="section-label">// About</p>
      <h1>Thales Pomari</h1>
      <p class="subtitle">Tech Lead · Data Engineer · MLOps</p>
    </div>
  </section>

  <hr class="divider" style="margin:0; border-color: var(--border);" />

  <!-- BIO -->
  <section class="section">
    <div class="container bio-grid">
      <div class="bio-label">
        <p class="section-label">// Bio</p>
      </div>
      <div class="bio-content">
        <p>
          I'm a Data Engineer and MLOps specialist with experience building data infrastructure
          and AI systems that solve real business problems across multiple industries.
        </p>
        <p>
          My background spans credit scoring, telecom, food retail, and life insurance — giving me
          a broad perspective on how data challenges vary by domain and scale.
        </p>
        <p>
          My signature skill is <strong>learning fast and finding the right technology fit</strong>
          for the time and budget of each problem. I don't over-engineer — I build what's needed,
          when it's needed, at the right cost.
        </p>
        <p>
          Today I work primarily with <strong>Apache Spark + Delta Lake</strong> for large-scale
          data processing, <strong>AWS</strong> as my main cloud platform, and
          <strong>FastAPI + HuggingFace</strong> for building AI-powered services.
        </p>
      </div>
    </div>
  </section>

  <hr class="divider" style="margin:0; border-color: var(--border);" />

  <!-- SKILLS -->
  <section class="section">
    <div class="container">
      <div class="bio-grid">
        <div class="bio-label">
          <p class="section-label">// Stack</p>
        </div>
        <div class="skills-grid">
          {skills.map(group => (
            <div class="skill-group">
              <h3>{group.category}</h3>
              <ul class="skill-list">
                {group.items.map(item => (
                  <li><span class="tag">{item}</span></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" style="margin:0; border-color: var(--border);" />

  <!-- COMPANIES -->
  <section class="section">
    <div class="container">
      <div class="bio-grid">
        <div class="bio-label">
          <p class="section-label">// Experience</p>
        </div>
        <div>
          <p style="color:var(--muted); margin-bottom: 2rem;">Companies and domains I've delivered data and AI solutions for:</p>
          <div class="companies-list">
            {companies.map((c, i) => (
              <div class="company-item">
                <span class="company-index">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <strong>{c.name}</strong>
                  <span class="company-domain">{c.domain}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" style="margin:0; border-color: var(--border);" />

  <!-- CTA -->
  <section class="section">
    <div class="container" style="text-align:center;">
      <h2>Let's build something.</h2>
      <p style="color:var(--muted);margin: 1rem auto 2rem;">Available for data engineering and AI infrastructure projects.</p>
      <a href="mailto:thales@thalespomari.dev" class="btn btn-accent">Get in Touch →</a>
    </div>
  </section>

</BaseLayout>

<style>
  .subtitle {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--muted);
    margin-top: 0.5rem;
    letter-spacing: 0.05em;
  }

  .bio-grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .bio-content p + p {
    margin-top: 1.25rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .skill-group h3 {
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.05em;
  }

  .skill-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .companies-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 2px solid var(--border);
    box-shadow: var(--shadow);
  }

  .company-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 1.25rem;
    border-bottom: 2px solid var(--border);
    transition: background 0.1s;
  }

  .company-item:last-child {
    border-bottom: none;
  }

  .company-item:hover {
    background: var(--fg);
    color: var(--bg);
  }

  .company-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    min-width: 2rem;
  }

  .company-item:hover .company-index {
    color: var(--accent);
  }

  .company-domain {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
    font-family: var(--font-mono);
    margin-top: 0.1rem;
  }

  .company-item:hover .company-domain {
    color: var(--bg);
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .bio-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
