---
import BaseLayout from '../layouts/BaseLayout.astro';

const skills = [
  { category: "Linguagens", items: ["Python", "Scala", "Java", "SQL", "Shell Script"] },
  { category: "Dados Distribuídos & Streaming", items: ["Apache Kafka", "Apache Spark", "Dataflow", "Hive", "MapReduce"] },
  { category: "Orquestração", items: ["Apache Airflow", "AWS Glue Workflows"] },
  { category: "AWS", items: ["Glue", "S3", "Lambda", "DynamoDB", "RDS", "SageMaker", "CloudWatch", "CodeBuild", "CloudFormation"] },
  { category: "GCP", items: ["BigQuery", "Dataproc", "Dataflow", "Bigtable", "GKE/Kubernetes", "Cloud Storage", "Cloud Build"] },
  { category: "MLOps", items: ["Produtização de Modelos e LLMs", "CI/CD", "Observabilidade e Alerting", "Model Serving", "APIs de Predição"] },
  { category: "IA Aplicada", items: ["Claude e Agentes de Código", "Gemma", "Llama", "Qwen"] },
];

const companies = [
  { name: "Equifax / Boa Vista Serviços", domain: "Credit Scoring" },
  { name: "TIM", domain: "Telecom" },
  { name: "Vivo", domain: "Telecom" },
  { name: "GPA", domain: "Food Retail" },
  { name: "Prudential", domain: "Life Insurance" },
];

const experience = [
  {
    title: "Tech Lead - Engenharia de Dados & MLOps",
    company: "Digiage Technologies, alocado em seguradora multinacional de grande porte (seguros de vida e investimentos)",
    location: "Campinas, SP",
    period: "06/2024 - Atual",
    bullets: [
      "Lidero squad de 5-8 engenheiros de dados: gestão técnica e estratégica do time, arquitetura de soluções e gestão de projetos sobre data lake de ~900 TB (AWS, arquitetura medalhão, Glue Workflows, Jobs e Data Catalog).",
      "Liderei a integração de um novo sistema de venda e gestão de apólices e sinistros (produto de vida com investimento): revisão de regras de negócio, modelagem e mapeamento de dados e construção das ETLs até o padrão do lake.",
      "Mantive e evoluí pipeline CDC com Apache Kafka para dados cadastrais, apólices e reclamações, processados e disponibilizados em DynamoDB com APIs consumidas pelo CRM de atendimento.",
      "Implantei observabilidade de ETLs do zero: biblioteca Python para jobs Glue com alertas via Lambda no Microsoft Teams (detalhes do erro + link para o CloudWatch), passando de detecção reativa por incidentes a resolução proativa, antes da percepção do usuário.",
      "Conduzi a engenharia de dados e MLOps do primeiro projeto de IA da companhia, uma solução de apoio à decisão na análise de reclamações: agregação de dados de cliente, apólice e reclamação, integração com o modelo de classificação desenvolvido pelo time de ciência de dados e entrega da sugestão fundamentada em dashboard Power BI.",
      "Gerenciei a integração com o Open Insurance: recepção de dados de outras seguradoras e envio no padrão regulatório exigido pela SUSEP.",
    ],
  },
  {
    title: "Engenheiro de MLOps (part-time)",
    company: "Inovia",
    location: "Remoto",
    period: "05/2025 - Atual",
    bullets: [
      "Construí o pipeline de produção de 3 LLMs open-source (Gemma, Llama e Qwen) para produtizar solução de análise de documentos.",
      "Desenvolvi APIs de consumo e gerenciamento de predições, com orquestração de modelos e versões.",
      "Gerencio a infraestrutura em nuvem para servir os modelos a clientes externos.",
      "Integro IA generativa ao fluxo de engenharia (Claude e agentes): code review, code quality e security, padronização de código e logging, reduzindo tempo de revisão e dependência de documentação. Implantei testes unitários e de ponta a ponta com apoio do Claude.",
    ],
  },
  {
    title: "Engenheiro de Dados",
    company: "Lima Consulting",
    location: "Campinas, SP",
    period: "04/2023 - 06/2024",
    bullets: [
      "Implantei e mantive CDP (Adobe Experience Platform / Real-Time CDP) para grandes empresas de telecom, varejo e setor bancário; no principal projeto, operadora de telecom com cerca de 80 milhões de clientes.",
      "Modelei schemas XDM com schema evolution e construí ingestões de dados em batch (conexão com BigQuery e mapeamento de arquivos CSV) e em streaming, configurando o Kafka do lado do cliente integrado ao AEP.",
      "Utilizei as APIs do AEP para consulta de dados de clientes, campanhas e segmentos.",
      "Desenvolvi relatórios analíticos via Query Service (PostgreSQL com estruturas JSON aninhadas): parsing para rastrear, em nível de cliente, os pontos de contato de cada campanha, reproduzindo a visão gráfica nativa da Adobe com filtros mais precisos.",
      "Criei jornadas de ativação multicanal no Adobe Journey Optimizer (e-mail, push e SMS), incluindo estratégias de IP warming de domínios, e participei da integração nativa entre Zenvia e Adobe para envio de SMS, especificando endpoints e documentando a troca de informações entre os sistemas.",
      "Construí pipelines de dados com Airflow e Redshift em ambientes AWS e GCP.",
    ],
  },
  {
    title: "Engenheiro de Dados - MLOps",
    company: "Boa Vista SCPC, atual Equifax Brasil",
    location: "Campinas, SP",
    period: "03/2021 - 04/2023",
    bullets: [
      "Criei uma Feature Store interna para cadastro e gestão de modelos e variáveis (SQL e metadados, com edição e exclusão), com autenticação OAuth 2.0 integrada ao GCP e frontend em Bootstrap.",
      "Refatorei o cálculo de variáveis de similaridade e segmentação de BigQuery para Spark/Scala em Dataproc (cluster de 10-15 nós): execução reduzida de dias, com falhas e reinícios, para cerca de 4 horas, com corte de custos cloud.",
      "Desenvolvi APIs REST em Flask e DAGs no Airflow com jobs em Python para processamento de dados e cálculo de modelos e variáveis.",
      "Realizei deploys via CI/CD e mantive projetos no GCP: Kubernetes, Dataflow, Bigtable, BigQuery e Cloud Storage.",
    ],
  },
  {
    title: "Engenheiro de Dados",
    company: "Digiage Technologies",
    location: "Campinas, SP",
    period: "06/2019 - 03/2021",
    bullets: [
      "Desenvolvi rotinas MapReduce em Java, executadas em servidores on-premise, para gerar indicadores de clientes pré e pós-pagos para o time de marketing de uma grande operadora de telecom, processando ETLs de cerca de 4,5 bilhões de linhas, com tuning do algoritmo por ambiente.",
      "Apoiei a definição de regras de negócio, mapeando os caminhos entre as tabelas para chegar às informações solicitadas pelo time de marketing.",
      "Realizei cargas e otimizações em Hive e Greenplum via Apache Sqoop, gerei análises e relatórios e mantive scripts SAS.",
    ],
  },
];

const education = [
  {
    degree: "Especialização em Ciência de Dados (pós-graduação)",
    institution: "Instituto Federal de São Paulo (IFSP) - Câmpus Campinas",
    period: "2021 - 2023",
    note: "Disciplinas concluídas; TCC em andamento",
  },
  {
    degree: "Graduação em Análise e Desenvolvimento de Sistemas",
    institution: "Instituto Federal de São Paulo (IFSP) - Câmpus Campinas",
    period: "2016 - 2019",
    note: "",
  },
];

const certifications = [
  {
    name: "Adobe Certified Expert - Adobe Real-Time CDP",
    detail: "Exames AD0-E600 e AD7-E601",
  },
];

const publications = [
  {
    authors: "POMARI, T.; RUPPERT, G.; REZENDE, E.; ROCHA, A.; CARVALHO, T.",
    title: "Image Splicing Detection Through Illumination Inconsistencies and Deep Learning",
    venue: "25th IEEE International Conference on Image Processing (ICIP), Atenas, Grécia, 2018, pp. 3788-3792",
    doi: "10.1109/ICIP.2018.8451227",
    doiUrl: "https://doi.org/10.1109/ICIP.2018.8451227",
  },
];

const languages = [
  { name: "Português", level: "Nativo" },
  { name: "Inglês", level: "Avançado" },
];
---

<BaseLayout title="About" description="About Thales Pomari – Tech Lead Data Engineer and MLOps specialist.">

  <section class="section">
    <div class="container">
      <p class="section-label">// About</p>
      <h1>Thales Pomari</h1>
      <p class="subtitle">Tech Lead · Data Engineer · MLOps</p>
    </div>
  </section>

  <hr class="divider" style="margin:0; border-color: var(--border);" />

  <!-- BIO -->
  <section class="section">
    <div class="container bio-grid">
      <div class="bio-label">
        <p class="section-label">// Bio</p>
      </div>
      <div class="bio-content">
        <p>
          I started my career as a researcher, publishing a
          <a href="https://ieeexplore.ieee.org/document/8451227" target="_blank" rel="noopener">paper at IEEE ICIP (International Conference on Image Processing)</a>
          before finding my path in data. I later grounded that foundation with a
          <strong>Postgraduate Program in Data Science</strong>.
        </p>
        <p>
          Today I'm a Data Engineer and MLOps specialist, building data infrastructure
          and AI systems that solve real business problems at scale. My work spans
          credit scoring, telecom, food retail, and life insurance, which gives me a broad
          perspective on how data challenges vary by domain and budget.
        </p>
        <p>
          My current stack centers on <strong>Apache Spark + Delta Lake</strong> for large-scale
          data processing, <strong>AWS</strong> as my main cloud platform, and
          <strong>FastAPI + HuggingFace</strong> for AI-powered services.
        </p>
        <p>
          My signature skill is <strong>learning fast and finding the right technology fit</strong>
          for the time and budget of each problem. I don't over-engineer. I build what's needed,
          when it's needed, at the right cost. As a tech leader, I also invest in the people side:
          communicating clearly across teams, unblocking colleagues, and making sure technical
          decisions are understood by everyone involved, not just engineers.
        </p>
      </div>
    </div>
  </section>

  <hr class="divider" style="margin:0; border-color: var(--border);" />

  <!-- SKILLS -->
  <section class="section">
    <div class="container">
      <div class="bio-grid">
        <div class="bio-label">
          <p class="section-label">// Stack</p>
        </div>
        <div class="skills-grid">
          {skills.map(group => (
            <div class="skill-group">
              <h3>{group.category}</h3>
              <ul class="skill-list">
                {group.items.map(item => (
                  <li><span class="tag">{item}</span></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" style="margin:0; border-color: var(--border);" />

  <!-- COMPANIES -->
  <section class="section">
    <div class="container">
      <div class="bio-grid">
        <div class="bio-label">
          <p class="section-label">// Experience</p>
        </div>
        <div>
          <p style="color:var(--muted); margin-bottom: 2rem;">Companies and domains I've delivered data and AI solutions for:</p>
          <div class="companies-list">
            {companies.map((c, i) => (
              <div class="company-item">
                <span class="company-index">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <strong>{c.name}</strong>
                  <span class="company-domain">{c.domain}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" style="margin:0; border-color: var(--border);" />

  <!-- CTA -->
  <section class="section">
    <div class="container" style="text-align:center;">
      <h2>Let's build something.</h2>
      <p style="color:var(--muted);margin: 1rem auto 2rem;">Available for data engineering and AI infrastructure projects.</p>
      <a href="mailto:hello@thalespomari.dev" class="btn btn-accent">Get in Touch →</a>
      <p style="color:var(--muted);font-family:var(--font-mono);font-size:0.8rem;margin-top:1.5rem;">São Paulo, BR</p>
    </div>
  </section>

</BaseLayout>

<style>
  .bio-content a {
    color: var(--accent);
    text-decoration: underline;
    font-weight: 500;
  }

  .bio-content a:hover {
    color: var(--accent);
  }

  .subtitle {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--muted);
    margin-top: 0.5rem;
    letter-spacing: 0.05em;
  }

  .bio-grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .bio-content p + p {
    margin-top: 1.25rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .skill-group h3 {
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.05em;
  }

  .skill-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .companies-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 2px solid var(--border);
    box-shadow: var(--shadow);
  }

  .company-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 1.25rem;
    border-bottom: 2px solid var(--border);
    transition: background 0.1s;
  }

  .company-item:last-child {
    border-bottom: none;
  }

  .company-item:hover {
    background: var(--fg);
    color: var(--bg);
  }

  .company-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    min-width: 2rem;
  }

  .company-item:hover .company-index {
    color: var(--accent);
  }

  .company-domain {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
    font-family: var(--font-mono);
    margin-top: 0.1rem;
  }

  .company-item:hover .company-domain {
    color: var(--bg);
    opacity: 0.7;
  }

  @media (max-width: 768px) {
    .bio-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
