---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Thales Pomari – Data Engineer & MLOps. I build data pipelines and AI infrastructure at scale." } = Astro.props;
// Astro.url.pathname inclui o `base` configurado (ex: "/thalespomari.dev/about/"
// no fallback do GitHub Pages, quando GITHUB_PAGES_CUSTOM_DOMAIN_ACTIVE não está
// ativo) e uma barra final adicionada pelo build estático. Normalizamos para
// comparar com as rotas canônicas ("/about") usadas no mapa de idiomas e no
// estado ativo do menu de navegação.
const base = import.meta.env.BASE_URL;
const pathWithoutBase =
  base !== '/' && Astro.url.pathname.startsWith(base)
    ? Astro.url.pathname.slice(base.length - 1)
    : Astro.url.pathname;
const currentPath =
  pathWithoutBase.length > 1 ? pathWithoutBase.replace(/\/$/, '') : pathWithoutBase;
const locale = Astro.currentLocale ?? 'pt';

// Mapeia a rota atual para o equivalente no outro idioma.
// Blog é exclusivo em PT (fora de escopo desta história); a partir do
// blog em PT, o toggle para EN leva à home EN por não haver rota equivalente.
const ptToEn: Record<string, string> = {
  '/': '/en',
  '/about': '/en/about',
  '/projects': '/en/projects',
};
const enToPt: Record<string, string> = {
  '/en': '/',
  '/en/about': '/about',
  '/en/projects': '/projects',
};

const otherLocaleHref =
  locale === 'en'
    ? enToPt[currentPath] ?? '/'
    : ptToEn[currentPath] ?? '/en';

// Links do nav principal (Home, About, Projects, Contact) precisam apontar
// para as rotas do locale ativo. Blog é exclusivo em PT (fora de escopo da
// bilinguização) — o link de Blog permanece fixo em PT em qualquer locale.
const homeHref = locale === 'en' ? '/en' : '/';
const aboutHref = locale === 'en' ? '/en/about' : '/about';
const projectsHref = locale === 'en' ? '/en/projects' : '/projects';
const contactHref = locale === 'en' ? '/en/#contact' : '/#contact';

const isHomeActive = currentPath === homeHref;
const isAboutActive = currentPath === aboutHref;
const isProjectsActive = currentPath === projectsHref;
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | thalespomari.dev</title>
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <nav class="nav">
      <div class="container nav-inner">
        <a href={homeHref} class="nav-logo">
          thales<span>.</span>pomari
        </a>
        <ul class="nav-links" id="nav-links">
          <li><a href={homeHref} class={isHomeActive ? 'active' : ''}>Home</a></li>
          <li><a href={aboutHref} class={isAboutActive ? 'active' : ''}>About</a></li>
          <li><a href={projectsHref} class={isProjectsActive ? 'active' : ''}>Projects</a></li>
          <li><a href="/blog" class={currentPath.startsWith('/blog') ? 'active' : ''}>Blog</a></li>
          <li><a href={contactHref}>Contact</a></li>
        </ul>
        <div style="display:flex;gap:0.5rem;align-items:center;">
          <a
            href={otherLocaleHref}
            class="theme-toggle lang-toggle"
            aria-label={locale === 'en' ? 'Mudar para português' : 'Switch to English'}
          >{locale === 'en' ? 'PT' : 'EN'}</a>
          <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">◐</button>
          <button class="theme-toggle" id="menu-toggle" aria-label="Toggle menu" style="display:none">☰</button>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} Thales Pomari. Built with Astro.</span>
        <div style="display:flex;gap:1rem;">
          <a href="https://linkedin.com/in/thalespomari" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://github.com/thalespomari" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
    </footer>

    <script>
      // Theme toggle
      const toggle = document.getElementById('theme-toggle');
      const html = document.documentElement;
      const saved = localStorage.getItem('theme') || 'light';
      html.setAttribute('data-theme', saved);

      toggle?.addEventListener('click', () => {
        const current = html.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });

      // Mobile menu
      const menuToggle = document.getElementById('menu-toggle');
      const navLinks = document.getElementById('nav-links');
      const mobileToggleBtn = document.getElementById('menu-toggle');

      function handleResize() {
        if (mobileToggleBtn) {
          mobileToggleBtn.style.display = window.innerWidth <= 640 ? 'block' : 'none';
        }
      }

      handleResize();
      window.addEventListener('resize', handleResize);

      menuToggle?.addEventListener('click', () => {
        navLinks?.classList.toggle('open');
      });
    </script>
  </body>
</html>
